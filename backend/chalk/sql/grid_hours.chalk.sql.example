-- Production data path (not active: rename to grid_hours.chalk.sql once a PostgreSQL source named
-- PG exists in the Chalk environment). Syntax: https://docs.chalk.ai/docs/sql
-- The table is the processed EIA-930 + ERCOT curtailment hourly table, refreshed from the EIA API.
-- ts is the slot END (UTC): point-in-time queries only see slots that had ended by query time.
-- type: offline
-- resolves: grid_hour
-- source: PG
-- incremental:
--   mode: row
--   lookback_period: 2d
--   incremental_column: ts
select
    id, region, ts, hour_cst, demand_mw, wind_mw, solar_mw, nuclear_mw, hydro_mw, other_mw,
    storage_mw, net_imports_mw, wind_curtailed_mw, solar_curtailed_mw
from eia930_erco_hourly
