# Copy to .env (never commit .env). See docs/design.md section B7.

# Required: EIA API v2 key (free, emailed after registering at https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Required for the Chalk sponsor track (dashboard: Settings > Access tokens)
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=

# Optional: EPA CAMPD validation (free api.data.gov key: https://api.data.gov/signup/)
DATA_GOV_API_KEY=

# Optional: ERCOT Public API (curtailment, prices)
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=
