# Copy to .env (never commit .env). See docs/design.md section B7.

# Required: EIA API v2 key (free, emailed after registering at https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Required for the Chalk sponsor track (dashboard: Settings > Access tokens)
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=

# Optional: EPA CAMPD validation (free api.data.gov key: https://api.data.gov/signup/)
DATA_GOV_API_KEY=

# Optional: ERCOT Public API (curtailment, prices)
ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=

# Chalk Model Gateway for the bid assistant (dashboard: Model Gateway > Access > API keys, or
# `chalk router api-key create`). Needs a provider connection (Model Gateway > Routing >
# Connections) with a Claude Console or OpenAI key. Empty -> the assistant uses its labeled
# local (rule-based) fallback. CHALK_ENVIRONMENT above is sent as X-Chalk-Env-Id.
CHALK_ROUTER_API_KEY=
CHALK_API_HOST=https://api.chalk.ai
CHALK_MODEL=anthropic/claude-sonnet-4-6
CHALK_VISION_MODEL=anthropic/claude-sonnet-4-6
